{# Card grid component, the one card markup for project cards.
   Usage: {% set items = collections.projects %}{% set type = "project" %}{% set gridClass = "" %}{% include "partials/card-grid.njk" %}
   `gridClass` is "card-grid--pairs" for cards two to a row, or empty.
#}
{% set pairs = gridClass == "card-grid--pairs" %}
<div class="card-grid{% if gridClass %} {{ gridClass }}{% endif %}">
    {% for item in items %}
    <a class="card card--{{ type }}" href="{{ item.url }}">
        {% if item.data.image %}
        {# Decoration here: the card's own heading names the project. #}
        <img{% if item.data.coverFit == "contain" %} class="card-img--contain"{% endif %} src="{{ item.data.image }}" alt="" sizes="{{ '(max-width: 480px) 92vw, (max-width: 900px) 45vw, 460px' if pairs else '(max-width: 480px) 92vw, (max-width: 900px) 45vw, 300px' }}">
        {% endif %}
        <div class="card-body">
            <p class="project-date">{{ item | cvDateRange }}</p>
            <h3>{{ item.data.title }}</h3>
            <p>{{ item.data.summary }}</p>
        </div>
    </a>
    {% endfor %}
</div>
