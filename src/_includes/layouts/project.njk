---
layout: layouts/base.njk
---
{# A project page: a header from its front matter (dates come from its CV entry), then the write-up. #}
<article class="project">
    <header class="project-header">
        <h1>{{ title }}</h1>
        <p class="project-meta">{{ cv | cvRange(page.inputPath) }}{% if role %} · {{ role }}{% endif %}</p>
        {% if links and links | length %}
        <p class="project-links">{% for link in links %}{% if not loop.first %} · {% endif %}<a href="{{ link.href }}">{{ link.label }}</a>{% endfor %}</p>
        {% endif %}
    </header>
    {{ content | safe }}
</article>
