---
layout: layouts/base.njk
title: Home
permalink: /
---

<section class="hero-profile">
    <div>
        {% if site.headshot %}
        <img class="hero-photo" src="{{ site.headshot }}" alt="{{ site.name }} portrait" loading="eager" fetchpriority="high" sizes="(max-width: 720px) 100vw, 320px">
        {% else %}
        <div class="hero-photo hero-photo-placeholder">{{ site.name | slice(0, 2) }}</div>
        {% endif %}
    </div>
    <div>
        <h2>Hi, I'm {{ site.name }}.</h2>
        <p>I'm a CS Master's student at UC San Diego, researching autonomous surgical robotics at the Advanced Robotics and Controls Lab and working with AquaMesh and the Scripps COOL Lab on the AquaSpectra water-quality sensor. I spent this summer at Brightree (a ResMed company) as a Technical Product Manager Intern, and before that led wildlife-tracking projects at Engineers for Exploration. On the side I build infrastructure for agents—Tasque and Jackdaw—and I like problems where robotics, machine learning, and dependable systems meet.</p>
        {% if site.social %}
        <ul class="link-list">
            {% for link in site.social %}
            <li>
                <a href="{{ link.url }}">{{ link.label }}</a>
            </li>
            {% endfor %}
            <li>
                <a href="/cv">CV</a>
            </li>
        </ul>
        {% endif %}
        {% if resume.interests.length %}
        <div class="interests">
            <h2 class="interests-label" id="interests-label">Interests</h2>
            <ul class="interest-list" aria-labelledby="interests-label">
                {% for interest in resume.interests %}
                <li class="interest-bubble">
                    <span class="interest-emoji" aria-hidden="true">{{ interest.emoji }}</span>{{ interest.label }}
                </li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}
    </div>
</section>

<section class="experience-section">
    <h2>Experience</h2>
    {% set items = resume.experience %}
    {% set type = "experience" %}
    {% include "partials/timeline.njk" %}
</section>

{% if resume.publications.length %}
<section class="experience-section">
    <h2>Publications</h2>
    {% set items = resume.publications %}
    {% set type = "publication" %}
    {% include "partials/timeline.njk" %}
</section>
{% endif %}

<section class="experience-section">
    <h2>Education</h2>
    {% set items = resume.education %}
    {% set type = "education" %}
    {% include "partials/timeline.njk" %}
</section>

<section class="experience-section">
    <h2>Volunteering</h2>
    {% set items = resume.volunteering %}
    {% set type = "volunteering" %}
    {% include "partials/timeline.njk" %}
</section>
