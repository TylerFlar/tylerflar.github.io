---
layout: layouts/base.njk
title: Home
permalink: /
---

<section class="hero-profile">
    <div>
        {% if site.headshot %}
        <img class="hero-photo" src="{{ site.headshot }}" alt="{{ site.name }} portrait" loading="eager" fetchpriority="high" sizes="(max-width: 720px) 100vw, 320px">
        {% else %}
        <div class="hero-photo hero-photo-placeholder">{{ site.name | slice(0, 2) }}</div>
        {% endif %}
    </div>
    <div>
        <h2>Hi, I'm {{ site.name }}.</h2>
        <p>{{ resume.profile.bio | safe }}</p>
        {% if site.social %}
        <ul class="link-list">
            {% for link in site.social %}
            <li>
                <a href="{{ link.url }}">{{ link.label }}</a>
            </li>
            {% endfor %}
            <li>
                <a href="/cv/">CV</a>
            </li>
        </ul>
        {% endif %}
    </div>
</section>

{# Research in one place: the interests line from the CV, the research roles, then the papers. #}
<section class="experience-section research-section">
    <h2>Research</h2>
    {% if resume.researchInterests %}
    <p class="research-interests">{{ resume.researchInterests | safe }}</p>
    {% endif %}
    {% for group in resume.experienceGroups %}
    {% if group.track == "research" %}
    {% set items = group.items %}
    {% set type = "experience" %}
    {% include "partials/timeline.njk" %}
    {% endif %}
    {% endfor %}
    {% if resume.publications.length %}
    <h3 class="group-divider">
        <span class="divider-label">Publications</span>
        <span class="divider-line" aria-hidden="true"></span>
    </h3>
    {% set items = resume.publications %}
    {% set type = "publication" %}
    {% include "partials/timeline.njk" %}
    {% endif %}
</section>

<section class="experience-section">
    <h2>Selected projects</h2>
    {% set items = collections.projects | newestFirst | inCategory("research") | filterByField("data.featured", true) %}
    {% set type = "project" %}
    {% include "partials/card-grid.njk" %}
    <p class="section-more"><a href="/projects/">All projects</a></p>
</section>

{# The rest of the CV's role sections, in its order: Industry Experience, then Teaching.
   The CV's titles are title case; the site's headings are sentence case. #}
{% for group in resume.experienceGroups %}
{% if group.track != "research" %}
<section class="experience-section">
    <h2>{{ group.title | capitalize }}</h2>
    {% set items = group.items %}
    {% set type = "experience" %}
    {% include "partials/timeline.njk" %}
</section>
{% endif %}
{% endfor %}

<section class="experience-section">
    <h2>Education</h2>
    {% set items = resume.education %}
    {% set type = "education" %}
    {% include "partials/timeline.njk" %}
</section>

<section class="experience-section">
    <h2>Volunteering</h2>
    {% set items = resume.volunteering %}
    {% set type = "volunteering" %}
    {% include "partials/timeline.njk" %}
</section>

{% if resume.interests.length %}
<section class="interests">
    <h2 class="interests-label" id="interests-label">Outside of work</h2>
    <ul class="interest-list" aria-labelledby="interests-label">
        {% for interest in resume.interests %}
        <li class="interest-bubble">
            <span class="interest-emoji" aria-hidden="true">{{ interest.emoji }}</span>{{ interest.label }}
        </li>
        {% endfor %}
    </ul>
</section>
{% endif %}
