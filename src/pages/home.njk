---
layout: layouts/base.njk
title: Home
permalink: /
---

<section class="hero-profile">
    <div>
        {% if site.headshot %}
        <img class="hero-photo" src="{{ site.headshot }}" alt="{{ site.name }} portrait" loading="eager" fetchpriority="high" sizes="(max-width: 720px) 100vw, 320px">
        {% else %}
        <div class="hero-photo hero-photo-placeholder">{{ site.name | slice(0, 2) }}</div>
        {% endif %}
    </div>
    <div>
        <h2>Hi, I'm {{ site.name }}.</h2>
        <p>{{ resume.profile.bio | safe }}</p>
        {% if site.social %}
        <ul class="link-list">
            {% for link in site.social %}
            <li>
                <a href="{{ link.url }}">{{ link.label }}</a>
            </li>
            {% endfor %}
            <li>
                <a href="/cv/">CV</a>
            </li>
        </ul>
        {% endif %}
        {% if resume.interests.length %}
        <div class="interests">
            <h2 class="interests-label" id="interests-label">Outside of work</h2>
            <ul class="interest-list" aria-labelledby="interests-label">
                {% for interest in resume.interests %}
                <li class="interest-bubble">
                    <span class="interest-emoji" aria-hidden="true">{{ interest.emoji }}</span>{{ interest.label }}
                </li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}
    </div>
</section>

{# The CV's sections, in the CV's order and with its entries (cv.yaml), so the
   homepage and the CV always match. The CV's titles are title case; the site's
   headings are sentence case. #}
{% for section in resume.sections %}
<section class="experience-section">
    <h2>{{ section.title | capitalize }}</h2>
    {% if section.kind == "project" %}
    {% set items = collections.projects | newestFirst | onCv(section.refs) %}
    {% set type = "project" %}
    {% include "partials/card-grid.njk" %}
    <p class="section-more"><a href="/projects/">All projects</a></p>
    {% elif section.kind == "skills" %}
    <div class="skill-grid">
        {% for group in section.groups %}
        <div class="skill-card">
            <h3>{{ group.label }}</h3>
            <ul class="skill-list">
                {% for skill in group.items %}
                <li>{{ skill.name }}{% if skill.details.length %} <span class="skill-details">({{ skill.details | join(", ") }})</span>{% endif %}</li>
                {% endfor %}
            </ul>
        </div>
        {% endfor %}
    </div>
    {% elif section.kind == "research-interests" %}
    <p class="research-interests">{{ section.text | safe }}</p>
    {% else %}
    {% set items = section.items %}
    {% set type = section.type %}
    {% include "partials/timeline.njk" %}
    {% endif %}
</section>
{% endfor %}
