---
layout: layouts/base.njk
title: Projects
permalink: /projects/
---

<section class="intro single">
    <div>
        <h2>Projects</h2>
        <p>Things I've built—from group research projects to personal experiments. Where a project was a team's, the page tells the whole story but says which part was mine.</p>
    </div>
</section>

{# Newest first by each project's CV dates: still running, then the latest end, then the latest start #}
{% set work = collections.projects | newestFirst %}
{% if work and work | length %}
<section>
    <div class="card-grid">
        {% for project in work %}
        <a class="card card--project" href="{{ project.url }}">
            {% if project.data.image %}
            <img src="{{ project.data.image }}" alt="{{ project.data.title }} preview" sizes="(max-width: 480px) 92vw, (max-width: 900px) 45vw, 300px">
            {% endif %}
            {% if project.data.tags %}
            <div class="tag-list">
                {% for tag in project.data.tags %}
                    {% if tag != 'projects' %}
                    <span class="tag-pill">{{ tag }}</span>
                    {% endif %}
                {% endfor %}
            </div>
            {% endif %}
            <p class="project-date">{{ project | cvDateRange }}</p>
            <h3>{{ project.data.title }}</h3>
            <p>{{ project.data.summary }}</p>
        </a>
        {% endfor %}
    </div>
</section>
{% else %}
<section>
    <p>Projects are being documented. Check back soon.</p>
</section>
{% endif %}
