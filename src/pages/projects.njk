---
layout: layouts/base.njk
title: Projects
permalink: /projects/
---

<section class="intro single">
    <div>
        <h2>Projects</h2>
        <p>{{ resume.profile.projectsIntro | safe }}</p>
    </div>
</section>

{# Research first, then software and experiments, then class projects; within each, newest first by the projects' CV dates. #}
{% set work = collections.projects | newestFirst %}
{% set groups = [{ key: "research", title: "Research" }, { key: "software", title: "Software & experiments" }, { key: "class", title: "Class projects" }] %}
<div class="project-groups">
    {% for group in groups %}
    {% set items = work | inCategory(group.key) %}
    {% if items | length %}
    <section class="project-group" aria-labelledby="group-{{ group.key }}">
        <h2 class="group-divider" id="group-{{ group.key }}">
            <span class="divider-label">{{ group.title }}</span>
            <span class="divider-line" aria-hidden="true"></span>
        </h2>
        {% set type = "project" %}
        {% include "partials/card-grid.njk" %}
    </section>
    {% endif %}
    {% endfor %}
</div>
