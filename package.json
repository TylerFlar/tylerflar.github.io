{
  "name": "tylerflar.github.io",
  "version": "1.2.1",
  "description": "My website, built with Eleventy, plus the CV it shares its data with.",
  "private": true,
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs');for(const e of fs.existsSync('docs')?fs.readdirSync('docs'):[])if(e!=='img')fs.rmSync('docs/'+e,{recursive:true,force:true})\"",
    "build": "eleventy",
    "serve": "eleventy --serve --port 8080",
    "test": "npm run test:resumes",
    "test:resumes": "node --test \"_resumes/_lib/*.test.js\"",
    "cv": "node _resumes/_resume.js",
    "apply": "node _resumes/_apply.js",
    "profiles": "node _resumes/_profiles.js",
    "hours": "node _resumes/_hours.js",
    "private": "git --git-dir=.private.git --work-tree=.",
    "private:save": "node _resumes/_private.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TylerFlar/tylerflar.github.io.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/TylerFlar/tylerflar.github.io/issues"
  },
  "homepage": "https://github.com/TylerFlar/tylerflar.github.io#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@11ty/eleventy-img": "^7.1.1",
    "js-yaml": "^5.5.0",
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "markdown-it": "^14.3.3",
    "markdown-it-mathjax3": "^4.3.2",
    "markdown-it-prism": "^3.0.1",
    "prismjs": "^1.29.0"
  },
  "overrides": {
    "speech-rule-engine": {
      "@xmldom/xmldom": "^0.9.12"
    }
  }
}
